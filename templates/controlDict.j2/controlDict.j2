/* Rendered by flowtest from {{ spec.name }}. deltaT is managed by the
   convergence ladder to hold maxCo under {{ max_co }}. */
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }

application     simpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         {{ end_time }};
deltaT          {{ delta_t }};
writeControl    timeStep;
writeInterval   100;
adjustTimeStep  yes;
maxCo           {{ max_co }};
